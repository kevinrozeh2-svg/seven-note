# Supabase Configuration (Optional - also configurable via the in-app Settings UI)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (VAPID Public Key for background notifications when the browser is closed)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Remote MCP Server (/api/mcp) - Configure these in Vercel Environment Variables (server-only, never VITE_*)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SEVEN_NOTE_MCP_API_KEY=generate-a-long-random-secret-token
# Optional: set to "true" to let bots read private spaces/docs (defaults to false for safety)
MCP_INCLUDE_PRIVATE=false
